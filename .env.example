# ============================================================
#  SakoSaring — Environment Variables (contoh)
# ============================================================
# Salin file ini menjadi `.env` lalu sesuaikan.
#   cp .env.example .env
#
# DATA UDARA: tidak butuh konfigurasi. Aplikasi mengambil data
# real dari CAMS via Open-Meteo + BMKG melalui /api/udara
# (Vercel Serverless Function).
#
# DATABASE (opsional, hanya untuk mencatat donasi):
#   - Di Vercel: set env var bernama DATABASE_URL (server-side,
#     TIDAK diekspos ke browser).
#   - Jalankan schema.sql di Neon SQL Editor.
#
# !!! PERHATIAN KEAMANAN !!!
# Prefix VITE_ membuat variabel TEREKSPOS di browser (client-side).
# Jangan taruh kredensial database dengan prefix VITE_.
# ============================================================

# Interval auto-refresh data (milidetik). Default: 60000 (1 menit)
VITE_REFRESH_INTERVAL=60000

# URL endpoint API (opsional). Default: relatif terhadap domain app.
# VITE_API_BASE_URL=https://sakosaring.my.id
