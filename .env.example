# ============================================================
#  SakoSaring — Environment Variables (contoh)
# ============================================================
# Salin file ini menjadi `.env` lalu isi kredensial Neon Anda.
#   cp .env.example .env
#
# !!! PERHATIAN KEAMANAN !!!
# Prefix VITE_ membuat variabel TEREKSPOS di browser (client-side).
# Untuk produksi, jangan taruh kredensial database di sini.
# Gunakan Vercel/Netlify/Cloudflare Function + proxy API.
# Lihat README.md bagian "Keamanan Database".
# ============================================================

# Koneksi Neon PostgreSQL (format: postgresql://user:pass@host/db?sslmode=require)
VITE_NEON_CONNECTION_STRING=

# Interval auto-refresh data (milidetik). Default: 60000 (1 menit)
VITE_REFRESH_INTERVAL=60000

# URL endpoint API aman (opsional, untuk produksi)
# Jika diisi, app akan memakai endpoint ini alih-alih koneksi DB langsung.
VITE_API_BASE_URL=
